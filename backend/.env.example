# Copy these values into Render > Your Web Service > Environment.
# Do NOT commit a real .env file with secrets.

# Supabase database connection pooler URL.
# Use your real Supabase pooler URL in Render, not here.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-eu-north-1.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://bfab.io,https://www.bfab.io,https://oibaf88.github.io

PYTHON_VERSION=3.12.8
