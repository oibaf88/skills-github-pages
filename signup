  <script>
    function validateName(name) {
      return typeof name === "string" && name.trim().length > 2;
    }

    function validateEmail(email) {
      if (typeof email !== "string") return false;
      return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email.trim());
    }

    function validatePassword(password) {
      if (typeof password !== "string") return false;
      const hasMinimumLength = password.length > 8;
      const hasCapitalLetter = /[A-Z]/.test(password);
      const hasNumber = /\\d/.test(password);
      return hasMinimumLength && hasCapitalLetter && hasNumber;
    }

    class ValueError extends Error {
      constructor(message) {
        super(message);
        this.name = "ValueError";
      }
    }

    function validateUser(name, email, password) {
      if (validateName(name) === false) {
        throw new ValueError("Please make sure your name is greater than 2 characters!");
      }
      if (validateEmail(email) === false) {
        throw new ValueError("Your email address is in the incorrect format, please enter a valid email.");
      }
      if (validatePassword(password) === false) {
        throw new ValueError("Your password is too weak, ensure that your password is greater than 8 characters, contains a capital letter and a number.");
      }
      return true;
    }

    function registerUser(name, email, password) {
      try {
        validateUser(name, email, password);
      } catch (error) {
        return false;
      }
      return {
        name: name.trim(),
        email: email.trim(),
        password: "[validated but not displayed or stored in this static demo]"
      };
    }

    const form = document.getElementById("signup-form");
    const nameInput = document.getElementById("name");
    const emailInput = document.getElementById("email");
    const passwordInput = document.getElementById("password");
    const errorMessage = document.getElementById("error-message");
    const resultCard = document.getElementById("result-card");
    const resultTitle = document.getElementById("result-title");
    const resultOutput = document.getElementById("result-output");

    function setInputState(input, isValid) {
      input.classList.remove("valid", "invalid");
      if (input.value.length === 0) return;
      input.classList.add(isValid ? "valid" : "invalid");
    }

    function refreshInputStates() {
      setInputState(nameInput, validateName(nameInput.value));
      setInputState(emailInput, validateEmail(emailInput.value));
      setInputState(passwordInput, validatePassword(passwordInput.value));
    }

    [nameInput, emailInput, passwordInput].forEach((input) => {
      input.addEventListener("input", refreshInputStates);
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const name = nameInput.value;
      const email = emailInput.value;
      const password = passwordInput.value;
      refreshInputStates();
      errorMessage.textContent = "";

      try {
        validateUser(name, email, password);
        const user = registerUser(name, email, password);
        resultCard.className = "result-card visible success";
        resultTitle.textContent = "User validated";
        resultOutput.textContent = JSON.stringify(user, null, 2);
      } catch (error) {
        resultCard.className = "result-card visible failure";
        resultTitle.textContent = "Validation failed";
        resultOutput.textContent = JSON.stringify({
          error: error.name || "ValidationError",
          message: error.message || "User validation failed."
        }, null, 2);
        errorMessage.textContent = error.message || "User validation failed.";
      }
    });

    form.addEventListener("reset", () => {
      setTimeout(() => {
        [nameInput, emailInput, passwordInput].forEach((input) => {
          input.classList.remove("valid", "invalid");
        });
        errorMessage.textContent = "";
        resultCard.className = "result-card";
        resultTitle.textContent = "Result";
        resultOutput.textContent = "";
      }, 0);
    });
  </script>
</body>
